{
    "manifest_version": 3,

    "name": "FocusShield",

    "short_name": "FocusShield",

    "version": "1.0.0",

    "description": "Blocks selected social media websites during scheduled focus periods.",

    "icons": {

        "16": "icons/icon16.png",

        "32": "icons/icon32.png",

        "48": "icons/icon48.png",

        "128": "icons/icon128.png"

    },

    "action": {

        "default_title": "FocusShield",

        "default_popup": "popup.html"

    },

    "background": {

        "service_worker": "background.js",

        "type": "module"

    },

    "permissions": [

        "storage",

        "tabs",

        "activeTab",

        "webNavigation",

        "alarms"

    ],


    "host_permissions": [

        "<all_urls>",

        "https://*.firebaseio.com/*",

        "https://*.firebasedatabase.app/*",

        "https://identitytoolkit.googleapis.com/*"

    ],

    "web_accessible_resources": [

        {

            "resources": [

                "blocked.html",

                "blocked.js",

                "icons/*"

            ],

            "matches": [

                "<all_urls>"

            ]

        }

    ]
}